<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Browser end-to-end tests. Install browsers once after building:
      pwsh tests/J3D.E2E.Tests/bin/Debug/net10.0/playwright.ps1 install chromium firefox
    Choose the browser with the BROWSER environment variable (chromium | firefox).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- A Windows build also carries Playwright's Linux driver, so the same build runs Firefox in Docker (D139). -->
    <PlaywrightPlatform Condition="$([MSBuild]::IsOSPlatform('Windows'))">win;linux-x64</PlaywrightPlatform>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Playwright.Xunit.v3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\J3D.Web\J3D.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
