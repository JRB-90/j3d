{
  "name": "@j3d/viewer",
  "version": "0.0.0",
  "private": true,
  "description": "The three.js view of CAD and mesh models, with their import pipeline and the OCCT kernel behind it.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "j3d-source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./testing": {
      "j3d-source": "./src/testing.ts",
      "types": "./lib/testing.d.ts",
      "default": "./lib/testing.js"
    },
    "./touch": {
      "j3d-source": "./src/touch.ts",
      "types": "./lib/touch.d.ts",
      "default": "./lib/touch.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "peerDependencies": {
    "three": "~0.186.1"
  },
  "dependencies": {
    "@j3d/occt": "0.0.0",
    "camera-controls": "3.1.2"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/three": "0.186.0",
    "draco3dgltf": "1.5.7",
    "ktx2-encoder": "0.6.0",
    "meshoptimizer": "1.3.0",
    "three": "0.186.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
