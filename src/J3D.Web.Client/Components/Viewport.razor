<J3DViewer class="j3d-viewport" data-testid="viewport" Keys="ViewerKeys.Page" Keep="j3d" PauseKeysWhile="@OpenMenu" OnReady="OnViewerReady" OnNotice="Show">
    @if (_capabilities is { IsSupported: false })
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="ma-4">
            This browser does not support WebGL2, which J3D needs to display models.
        </MudAlert>
    }
    <ViewportHint />
    <ViewControls />
    <SelectionPanel />
</J3DViewer>
