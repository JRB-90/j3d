<div class="j3d-viewport" @ref="_host" data-testid="viewport">
    @if (Capabilities is { IsSupported: false })
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="ma-4">
            This browser does not support WebGL2, which J3D needs to display models.
        </MudAlert>
    }
</div>
