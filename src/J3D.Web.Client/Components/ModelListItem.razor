<div class="@ItemClass" data-testid="model-item" data-status="@StatusName" data-selected="@(ModelSelected ? "true" : "false")">
    <div class="j3d-model-header" data-model-drop="@(Model.Tree is not null ? Model.Id.Value : null)">
        <span class="j3d-model-name" title="@Model.Summary.FileName" data-testid="model-name">@Model.Summary.FileName</span>
        <span class="j3d-model-format" data-testid="model-format">@Model.Summary.Format.DisplayName</span>
        @if (KindLabel != Model.Summary.Format.DisplayName)
        {
            <span class="j3d-model-kind" data-testid="model-kind">@KindLabel</span>
        }
        @if (Model.IsPending)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           title="Cancel import"
                           aria-label="@($"Cancel importing {Model.Summary.FileName}")"
                           OnClick="RemoveAsync"
                           data-testid="cancel-model" />
        }
        else if (Model.Status == ModelStatus.Loaded)
        {
            <MudIconButton Icon="@EyeIcon(Model.Visibility())"
                           Size="Size.Small"
                           Class="@EyeClass(Model.Visibility())"
                           title="@EyeTitle(Model.Visibility())"
                           aria-label="@($"{EyeTitle(Model.Visibility())}: {Model.Summary.FileName}")"
                           OnClick="ToggleModelVisibility"
                           data-visibility="@Model.Visibility().ToString().ToLowerInvariant()"
                           data-testid="model-eye" />
            @* A BREP model saves itself, as edited (M9, D83, D119; M15, D145). *@
            @if (Model.Summary.Kind == ModelKind.Brep)
            {
                <MudMenu Icon="@Icons.Material.Outlined.FileDownload"
                         Size="Size.Small"
                         Dense="true"
                         Disabled="@(Model.Export is not null)"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight"
                         AriaLabel="@($"Export {Model.Summary.FileName}")"
                         title="Export"
                         data-testid="export-model">
                    @foreach (var format in BrepFormats)
                    {
                        <MudMenuItem Label="@format.DisplayName"
                                     OnClick="@(() => StartExport(format))"
                                     data-testid="@($"export-{format.ToString().ToLowerInvariant()}")" />
                    }
                </MudMenu>
            }
            <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                           Size="Size.Small"
                           title="Delete"
                           aria-label="@($"Delete {Model.Summary.FileName}")"
                           OnClick="RemoveAsync"
                           data-testid="delete-model" />
        }
        else
        {
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           title="Dismiss"
                           aria-label="@($"Dismiss {Model.Summary.FileName}")"
                           OnClick="RemoveAsync"
                           data-testid="dismiss-model" />
        }
    </div>

    @switch (Model.Status)
    {
        case ModelStatus.Queued:
            <div class="j3d-model-detail" data-testid="model-status">Queued</div>
            break;

        case ModelStatus.Importing:
            <div class="j3d-model-detail" data-testid="model-status">@ProgressText</div>
            <MudProgressLinear Color="Color.Primary"
                               Size="Size.Small"
                               Rounded="true"
                               Value="@Percent"
                               Indeterminate="@(Model.Fraction is null)"
                               Class="j3d-model-progress"
                               data-testid="model-progress" />
            break;

        case ModelStatus.Loaded when Model.Info is { } info:
            <div class="j3d-model-detail" data-testid="model-status">
                <span>@StatsText(info, Model.Stats ?? info.Stats)</span>
                @if (info.Warnings.Count > 0)
                {
                    <MudTooltip>
                        <TooltipContent>
                            @foreach (var warning in info.Warnings)
                            {
                                <div>@warning</div>
                            }
                        </TooltipContent>
                        <ChildContent>
                            <span role="img" aria-label="@string.Join(" ", info.Warnings)" data-testid="model-warnings">
                                <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" Size="Size.Small" />
                            </span>
                        </ChildContent>
                    </MudTooltip>
                }
            </div>
            @if (Model.Export is { } export)
            {
                <div class="j3d-model-detail" data-testid="model-export">
                    <span class="j3d-model-export-text" data-testid="model-export-status">@ExportText(export)</span>
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               Color="Color.Primary"
                               OnClick="CancelExportAsync"
                               aria-label="@($"Cancel exporting {Model.Summary.FileName}")"
                               data-testid="cancel-export">
                        Cancel
                    </MudButton>
                </div>
                <MudProgressLinear Color="Color.Primary"
                                   Size="Size.Small"
                                   Rounded="true"
                                   Value="@((export.Fraction ?? 0) * 100)"
                                   Indeterminate="@(export.Fraction is null)"
                                   Class="j3d-model-progress"
                                   data-testid="export-progress" />
            }
            @if (Model.Bringing is { } bringing)
            {
                @* Objects arriving from another model (M18, D233). *@
                <div class="j3d-model-detail" data-testid="model-bringing">@BringingText(bringing)</div>
                <MudProgressLinear Color="Color.Primary"
                                   Size="Size.Small"
                                   Rounded="true"
                                   Indeterminate="true"
                                   Class="j3d-model-progress" />
            }
            @if (Model.Expanding is { } expanding)
            {
                <div class="j3d-model-detail" data-testid="model-expanding">@ExpandingText(expanding)</div>
                <MudProgressLinear Color="Color.Primary"
                                   Size="Size.Small"
                                   Rounded="true"
                                   Indeterminate="true"
                                   Class="j3d-model-progress" />
            }
            @if (Model.NotKept is { } notKept)
            {
                <div class="j3d-model-detail j3d-model-not-kept" data-testid="model-not-kept">Not kept: @notKept</div>
            }
            <MudButton Variant="Variant.Text"
                       Size="Size.Small"
                       StartIcon="@(_treeOpen ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                       aria-expanded="@(_treeOpen ? "true" : "false")"
                       OnClick="ToggleTree"
                       Class="j3d-model-tree-toggle"
                       data-testid="model-tree-toggle">
                @TreeLabel
            </MudButton>
            @if (_treeOpen && Model.Tree is not null)
            {
                <ModelTreeView Model="Model" Reveal="_reveal" />
            }
            break;

        case ModelStatus.Failed when Model.Error is { } error:
            <div class="j3d-model-detail j3d-model-error" data-testid="model-status">
                <strong>@error.Code.DisplayName</strong>: @error.Message
            </div>
            break;
    }
</div>
