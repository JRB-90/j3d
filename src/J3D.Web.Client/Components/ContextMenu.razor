@* The context menu (M12, D164): opened by a right click that didn't drag, at the pointer. *@
<MudMenu @ref="_menu"
         PositionAtCursor="true"
         Dense="true"
         Class="j3d-context-menu"
         AriaLabel="Context menu"
         data-testid="context-menu">
    <ActivatorContent />
    <ChildContent>
        @if (_target is { } target)
        {
            @if (target.OnTarget)
            {
                <MudMenuItem Icon="@Icons.Material.Outlined.VisibilityOff" OnClick="Scene.HideSelection" data-testid="context-hide"><span class="j3d-menu-command"><span>Hide</span><kbd class="j3d-key">H</kbd></span></MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.FilterCenterFocus" Disabled="@(!Scene.CanIsolate)" OnClick="Scene.IsolateSelection" data-testid="context-isolate"><span class="j3d-menu-command"><span>Isolate</span><kbd class="j3d-key">I</kbd></span></MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.OpenWith" Disabled="@(Scene.MoveTarget is null)" OnClick="@(() => StartMoving(MoveMode.Translate))" data-testid="context-move"><span class="j3d-menu-command"><span>Move</span><kbd class="j3d-key">W</kbd></span></MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined._3dRotation" Disabled="@(Scene.MoveTarget is null)" OnClick="@(() => StartMoving(MoveMode.Rotate))" data-testid="context-rotate"><span class="j3d-menu-command"><span>Rotate</span><kbd class="j3d-key">E</kbd></span></MudMenuItem>
            }

            @if (target.CanMeasure)
            {
                <MudMenuItem Icon="@Icons.Material.Outlined.Straighten" OnClick="Scene.MeasureFromHere" data-testid="context-measure"><span class="j3d-menu-command"><span>Measure from here</span><kbd class="j3d-key">M</kbd></span></MudMenuItem>
            }

            @* Editing (M14, D152, D183): Object mode's commands on a target, Paste on empty space too, and Delete of models in Model mode (D187). *@
            @if (target.OnTarget && Scene.Mode == SelectMode.Objects)
            {
                <MudDivider Class="my-1" />
                <MudMenuItem Icon="@Icons.Material.Outlined.ContentCut" Disabled="@(!Scene.CanCut)" OnClick="Scene.Cut" data-testid="context-cut"><span class="j3d-menu-command"><span>Cut</span><kbd class="j3d-key">Ctrl+X</kbd></span></MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.ContentCopy" Disabled="@(!Scene.CanCopy)" OnClick="Scene.Copy" data-testid="context-copy"><span class="j3d-menu-command"><span>Copy</span><kbd class="j3d-key">Ctrl+C</kbd></span></MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.ContentPaste" Disabled="@(!Scene.CanPaste)" OnClick="Scene.Paste" data-testid="context-paste"><span class="j3d-menu-command"><span>Paste</span><kbd class="j3d-key">Ctrl+V</kbd></span></MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Delete" Disabled="@(!Scene.CanDelete)" OnClick="Scene.DeleteSelection" data-testid="context-delete"><span class="j3d-menu-command"><span>Delete</span><kbd class="j3d-key">Del</kbd></span></MudMenuItem>
                <MudDivider Class="my-1" />
                <MudMenuItem Icon="@Icons.Material.Outlined.CreateNewFolder" Disabled="@(!Scene.CanGroup)" OnClick="Scene.Group" data-testid="context-group"><span class="j3d-menu-command"><span>New assembly</span><kbd class="j3d-key">Ctrl+G</kbd></span></MudMenuItem>
                @if (Scene.CanUngroup)
                {
                    <MudMenuItem Icon="@Icons.Material.Outlined.FolderOff" OnClick="Scene.Ungroup" data-testid="context-ungroup"><span class="j3d-menu-command"><span>Ungroup</span><kbd class="j3d-key">Ctrl+Shift+G</kbd></span></MudMenuItem>
                }
                <MudMenuItem Icon="@Icons.Material.Outlined.DriveFileRenameOutline" Disabled="@(!Scene.CanRename)" OnClick="Scene.BeginRename" data-testid="context-rename"><span class="j3d-menu-command"><span>Rename</span><kbd class="j3d-key">F2</kbd></span></MudMenuItem>
                @* Expand (M15, D154, D197): only where there's a compound part to split. *@
                @if (Scene.ExpandTarget is not null)
                {
                    <MudMenuItem Icon="@Icons.Material.Outlined.AccountTree" OnClick="Expand" data-testid="context-expand">Expand</MudMenuItem>
                }
                @if (Scene.ExpandAllTargets.Count > 0)
                {
                    <MudMenuItem Icon="@Icons.Material.Outlined.AccountTree" OnClick="ExpandAll" data-testid="context-expand-all">Expand all</MudMenuItem>
                }
                <MudDivider Class="my-1" />
            }
            else if (target.OnTarget && Scene.Mode == SelectMode.Models)
            {
                @* Paste into another model's top level (M18, D226). *@
                @if (Scene.CanPaste)
                {
                    <MudMenuItem Icon="@Icons.Material.Outlined.ContentPaste" OnClick="Scene.Paste" data-testid="context-paste"><span class="j3d-menu-command"><span>Paste</span><kbd class="j3d-key">Ctrl+V</kbd></span></MudMenuItem>
                }
                <MudMenuItem Icon="@Icons.Material.Outlined.Delete" Disabled="@(!Scene.CanDelete)" OnClick="Scene.DeleteSelection" data-testid="context-delete"><span class="j3d-menu-command"><span>Delete</span><kbd class="j3d-key">Del</kbd></span></MudMenuItem>
                @if (Scene.ExpandAllTargets.Count > 0)
                {
                    <MudMenuItem Icon="@Icons.Material.Outlined.AccountTree" OnClick="ExpandAll" data-testid="context-expand-all">Expand all</MudMenuItem>
                }
            }
            else if (!target.OnTarget && Scene.CanPaste)
            {
                <MudMenuItem Icon="@Icons.Material.Outlined.ContentPaste" OnClick="Scene.Paste" data-testid="context-paste"><span class="j3d-menu-command"><span>Paste</span><kbd class="j3d-key">Ctrl+V</kbd></span></MudMenuItem>
            }

            @if (target.OnTarget)
            {
                <MudMenu Label="Export the selection" StartIcon="@Icons.Material.Outlined.FileDownload" Dense="true" data-testid="context-export">
                    @foreach (var format in Toolbar.MeshFormats)
                    {
                        <MudMenuItem Label="@format.DisplayName" OnClick="@(() => Scene.RequestExport(format, true))" data-testid="@($"context-export-{Toolbar.FormatKey(format)}")" />
                    }
                    @* STEP and BREP of a selection in one BREP model (M15, D192). *@
                    @if (Scene.SelectionBrepModel is not null)
                    {
                        <MudDivider Class="my-1" />
                        @foreach (var format in Toolbar.BrepFormats)
                        {
                            <MudMenuItem Label="@format.DisplayName" OnClick="@(() => Scene.RequestModelExport(format))" data-testid="@($"context-export-{format.ToString().ToLowerInvariant()}")" />
                        }
                    }
                </MudMenu>
            }
            else
            {
                <MudMenuItem Icon="@Icons.Material.Outlined.Visibility" Disabled="@(!Scene.HasHidden)" OnClick="Scene.ShowAll" data-testid="context-show-all"><span class="j3d-menu-command"><span>Show all</span><kbd class="j3d-key">Shift+H</kbd></span></MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.FitScreen" OnClick="FitAllAsync" data-testid="context-fit-all"><span class="j3d-menu-command"><span>Fit all</span><kbd class="j3d-key">F</kbd></span></MudMenuItem>
                <MudMenu Label="Export the scene" StartIcon="@Icons.Material.Outlined.FileDownload" Dense="true" Disabled="@(!Scene.CanExport)" data-testid="context-export">
                    @foreach (var format in Toolbar.MeshFormats)
                    {
                        <MudMenuItem Label="@format.DisplayName" OnClick="@(() => Scene.RequestExport(format, false))" data-testid="@($"context-export-{Toolbar.FormatKey(format)}")" />
                    }
                </MudMenu>
            }
        }
    </ChildContent>
</MudMenu>
