@if (IsVisible)
{
    <div class="j3d-selection-panel" role="status" aria-live="polite" data-testid="selection-panel">
        @if (Scene.Moving is not null)
        {
            @* The Move tool's fields (M13, D148, D167): the target's pose in the chosen frame, applied on Enter. *@
            <div class="j3d-move" data-testid="move-panel">
                @if (Scene.MoveTarget is { } target && Scene.TargetPose is { } pose)
                {
                    <div class="j3d-selection-title" title="@TargetName(target)" data-testid="move-title">@TargetName(target)</div>
                    <MudToggleGroup T="MoveFrame"
                                    Value="Scene.Frame"
                                    ValueChanged="SetFrame"
                                    Size="Size.Small"
                                    Class="j3d-segmented j3d-move-frame"
                                    aria-label="Frame"
                                    data-testid="move-frame">
                        @foreach (var frame in Frames)
                        {
                            <MudToggleItem Value="frame" Text="@frame.ToString()" data-testid="@($"move-frame-{frame.ToString().ToLowerInvariant()}")" />
                        }
                    </MudToggleGroup>
                    <div class="j3d-move-heading" data-testid="move-heading">@FieldsHeading</div>
                    <div class="j3d-move-fields">
                        @for (var i = 0; i < FieldNames.Length; i++)
                        {
                            var field = i;
                            <label class="j3d-move-field">
                                <span>@FieldNames[field]</span>
                                <input type="text"
                                       inputmode="decimal"
                                       value="@FieldValue(pose, field)"
                                       @oninput="@(args => _drafts[field] = args.Value?.ToString())"
                                       @onkeydown="@(args => OnFieldKey(args, pose))"
                                       aria-label="@FieldLabels[field]"
                                       data-testid="@($"move-{FieldNames[field].ToLowerInvariant()}")" />
                                <span class="j3d-move-unit">@(field < 3 ? "mm" : "°")</span>
                            </label>
                        }
                    </div>
                    <div class="j3d-move-actions">
                        <div class="j3d-measure-hint" data-testid="move-hint">
                            @(Scene.Frame == MoveFrame.Local
                                ? "Type how far to move or turn it about its own axes, then Apply or press Enter. Or drag the arrows (W) or rings (E); Ctrl snaps."
                                : "Type where to put it, then Apply or press Enter. Or drag the arrows (W) or rings (E); Ctrl snaps.")
                        </div>
                        <MudButton Variant="Variant.Outlined"
                                   Size="Size.Small"
                                   Color="Color.Inherit"
                                   OnClick="@(() => Apply(pose))"
                                   Class="j3d-move-apply"
                                   data-testid="move-apply">
                            Apply
                        </MudButton>
                    </div>
                }
                else
                {
                    <div class="j3d-measure-hint" data-testid="move-hint">@(Scene.MoveHint ?? "Finding where it is…")</div>
                }
            </div>
        }
        else if (Scene.MeasureMode)
        {
            <div class="j3d-measure" data-testid="measure-panel">
                @if (Scene.MeasureReference is { } reference)
                {
                    var referenceOpen = Scene.MeasureResult is null || _referenceOpen;
                    <div class="j3d-measure-card j3d-measure-card--reference" data-testid="measure-reference">
                        <div class="j3d-measure-card-header">
                            @if (Scene.MeasureResult is not null)
                            {
                                <MudIconButton Icon="@(referenceOpen ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                                               Size="Size.Small"
                                               aria-label="@(referenceOpen ? "Collapse" : "Expand")"
                                               aria-expanded="@(referenceOpen ? "true" : "false")"
                                               OnClick="@(() => _referenceOpen = !_referenceOpen)"
                                               data-testid="measure-reference-toggle" />
                            }
                            <span class="j3d-measure-card-title" title="@reference.Title">@reference.Title</span>
                        </div>
                        @if (referenceOpen)
                        {
                            @Rows(reference)
                        }
                    </div>
                }

                @if (Scene.MeasureResult is { } result)
                {
                    <div class="j3d-measure-card" data-testid="measure-result">
                        <div class="j3d-measure-card-title" title="@result.Title">@result.Title</div>
                        @Rows(result)
                    </div>
                }

                <div class="j3d-measure-hint" data-testid="measure-hint">
                    @(Scene.MeasureReference is null
                        ? "Pick a face, edge or vertex to measure from."
                        : "Pick another to measure against it. Esc stops measuring.")
                </div>
            </div>
        }
        else if (Scene.Mode == SelectMode.Features)
        {
            <div class="j3d-measure" data-testid="feature-panel">
                @foreach (var (feature, number) in Scene.Features.Features.Select(static (feature, index) => (feature, index + 1)).Reverse())
                {
                    var expanded = _expanded.Contains(feature.Id);
                    <div class="j3d-measure-card" data-testid="feature" data-feature-id="@feature.Id">
                        <div class="j3d-measure-card-header">
                            <MudIconButton Icon="@(expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                                           Size="Size.Small"
                                           aria-label="@(expanded ? "Collapse" : "Expand")"
                                           aria-expanded="@(expanded ? "true" : "false")"
                                           OnClick="@(() => Toggle(feature.Id))"
                                           data-testid="feature-toggle" />
                            <span class="j3d-card-number" aria-hidden="true">@number</span>
                            <span class="j3d-measure-card-title" title="@feature.Title" data-testid="feature-title">@feature.Title</span>
                        </div>
                        @if (expanded)
                        {
                            @Rows(feature)
                        }
                    </div>
                }

                @if (Scene.Features.Totals.Count > 0)
                {
                    <div class="j3d-measure-card" data-testid="feature-totals">
                        @Rows(Scene.Features.Totals)
                    </div>
                }
            </div>
        }
        else if (Summary is { } summary)
        {
            <div class="j3d-selection-title" title="@summary.Title" data-testid="selection-title">@summary.Title</div>
            <div class="j3d-selection-detail" title="@summary.Detail" data-testid="selection-detail">@summary.Detail</div>
        }
    </div>
}

@code {
    private RenderFragment Rows(MeasureInfo info) => Rows(info.Rows);

    /// <summary>
    /// The rows as a definition list: a part's rows under its name (D104), values right-aligned in tabular
    /// figures and grouped in thousands for reading, and a copy button, shown on hover or focus, that
    /// copies the value as it was formatted, without the grouping.
    /// </summary>
    private RenderFragment Rows(IReadOnlyList<MeasureRow> rows) =>
        @<dl class="j3d-measure-rows">
            @for (var i = 0; i < rows.Count; i++)
            {
                var row = rows[i];
                @if (row.Group is { } group && (i == 0 || rows[i - 1].Group != group))
                {
                    <div class="j3d-measure-group" data-testid="measure-group">@group</div>
                }
                <div class="@(row.Group is null ? "j3d-measure-row" : "j3d-measure-row j3d-measure-row--grouped")" data-testid="measure-row">
                    <dt>@row.Name</dt>
                    <dd>
                        <span class="j3d-measure-value" data-testid="measure-value">@DisplayFormat.Grouped(row.Value)</span>
                        @if (DisplayFormat.HasNumber(row.Value))
                        {
                            <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy"
                                           Size="Size.Small"
                                           aria-label="@($"Copy {row.Name}")"
                                           title="Copy"
                                           OnClick="@(() => CopyAsync(row.Value))"
                                           Class="j3d-measure-copy"
                                           data-testid="measure-copy" />
                        }
                    </dd>
                </div>
            }
        </dl>;
}
