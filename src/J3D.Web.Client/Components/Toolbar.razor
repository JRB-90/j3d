<div class="j3d-toolbar" data-testid="toolbar">
    @* A native label opens the file picker, so no JS user-activation trickery is needed (docs/plan.md §6.4).
       The viewer sets the input's accept list and imports what is picked. *@
    <input @ref="_input"
           id="@InputId"
           type="file"
           multiple
           class="j3d-visually-hidden"
           disabled="@(!Session.IsReady)"
           data-testid="import-input" />

    @* Files in and out, and framing them (D48, D119). Below 1,400 px they keep only their icons (D135, D222).
       Each group but History folds into ⋮ when the bar runs out of room (M19, D235): this one first. *@
    <div class="j3d-toolbar-group j3d-toolbar-group--first j3d-fold-files" role="group" aria-label="Files and view">
        <MudTooltip Text="Import STEP, IGES, BREP, STL, OBJ or glTF files, or drop them on the view">
            <MudButton HtmlTag="label"
                       for="@InputId"
                       StartIcon="@Icons.Material.Outlined.FileOpen"
                       Color="Color.Inherit"
                       Disabled="@(!Session.IsReady)"
                       Class="j3d-tool j3d-collapsible"
                       aria-label="Import"
                       data-testid="import-button">
                <span class="j3d-tool-label">Import</span>
            </MudButton>
        </MudTooltip>

        @* Export (M9, D119): the selection when there is one, else every visible part. Busy while it's written (D125). *@
        <MudMenu StartIcon="@(_exporting ? Icons.Material.Outlined.HourglassTop : Icons.Material.Outlined.FileDownload)"
                 Label="@(_exporting ? "Exporting…" : "Export")"
                 Color="Color.Inherit"
                 Disabled="@(!Session.IsReady || !Scene.CanExport || _exporting)"
                 AnchorOrigin="Origin.BottomLeft"
                 TransformOrigin="Origin.TopLeft"
                 Dense="true"
                 AriaLabel="@ExportLabel"
                 Class="j3d-tool j3d-collapsible"
                 title="@ExportLabel"
                 aria-busy="@(_exporting ? "true" : "false")"
                 data-testid="export-menu">
            <div class="j3d-menu-header" data-testid="export-scope">@ExportLabel</div>
            @foreach (var format in MeshFormats)
            {
                <MudMenuItem Label="@format.DisplayName" OnClick="@(() => StartExport(format, Scene.HasSelection))" data-testid="@($"export-{FormatKey(format)}")" />
            }
            @* STEP and BREP of a selection in one BREP model, which its list item writes (M15, D192). *@
            @if (Scene.SelectionBrepModel is not null)
            {
                <MudDivider Class="my-1" />
                @foreach (var format in BrepFormats)
                {
                    <MudMenuItem Label="@format.DisplayName" OnClick="@(() => Scene.RequestModelExport(format))" data-testid="@($"export-{format.ToString().ToLowerInvariant()}")" />
                }
            }
        </MudMenu>

        <MudTooltip Text="Fit everything visible in the view (F)">
            <MudButton StartIcon="@Icons.Material.Outlined.FitScreen"
                       Color="Color.Inherit"
                       Disabled="@(!Session.IsReady)"
                       OnClick="FitAllAsync"
                       Class="j3d-tool j3d-collapsible"
                       aria-label="Fit all"
                       data-testid="fit-all-button">
                <span class="j3d-tool-label">Fit all</span>
            </MudButton>
        </MudTooltip>
    </div>

    @* What a click selects (M12, D146): models, objects or features, with the keys 1, 2 and 3 (D162). *@
    <div class="j3d-toolbar-group j3d-fold-select" role="group" aria-label="Select">
        <MudToggleGroup T="SelectMode"
                        Value="Scene.Mode"
                        ValueChanged="Scene.SetSelectionMode"
                        Size="Size.Small"
                        Disabled="@(!Session.IsReady)"
                        Class="j3d-segmented j3d-selection-mode"
                        aria-label="Selection mode"
                        data-testid="selection-mode">
            @foreach (var mode in SelectModes)
            {
                <MudToggleItem Value="mode" aria-pressed="@(Scene.Mode == mode ? "true" : "false")" aria-label="@ModeName(mode)" data-testid="@($"mode-{ModeKey(mode)}")">
                    <MudTooltip Text="@ModeTooltip(mode)">
                        <span class="j3d-segment">
                            <MudIcon Icon="@ModeIcon(mode)" Size="Size.Small" />
                            <span class="j3d-tool-label">@ModeName(mode)</span>
                        </span>
                    </MudTooltip>
                </MudToggleItem>
            }
        </MudToggleGroup>

        @* Add (M19, D237): on a touch screen, where there's no Ctrl to hold, taps add or remove while it's on. *@
        <MudTooltip Text="@(Scene.AddMode ? "Stop adding to the selection" : "Taps add to the selection or take from it (or hold Ctrl)")" RootClass="j3d-add">
            <MudButton StartIcon="@Icons.Material.Outlined.LibraryAdd"
                       Color="Color.Inherit"
                       Disabled="@(!Session.IsReady)"
                       OnClick="Scene.ToggleAddMode"
                       Class="@ToolClass(Scene.AddMode)"
                       aria-label="Add"
                       aria-pressed="@(Scene.AddMode ? "true" : "false")"
                       data-testid="add-button">
                <span class="j3d-tool-label">Add</span>
            </MudButton>
        </MudTooltip>
    </div>

    @* The tools, each on until it's turned off (M7, D79; M13, D149, D150). *@
    <div class="j3d-toolbar-group j3d-fold-tools" role="group" aria-label="Tools">
        <MudTooltip Text="@(Scene.MeasureMode ? "Stop measuring (M or Esc)" : "Measure faces, edges and vertices (M)")">
            <MudButton StartIcon="@Icons.Material.Outlined.Straighten"
                       Color="Color.Inherit"
                       Disabled="@(!Session.IsReady)"
                       OnClick="Scene.ToggleMeasureMode"
                       Class="@ToolClass(Scene.MeasureMode)"
                       aria-label="Measure"
                       aria-pressed="@(Scene.MeasureMode ? "true" : "false")"
                       data-testid="measure-button">
                <span class="j3d-tool-label">Measure</span>
            </MudButton>
        </MudTooltip>

        @* Move and Rotate (M17, D208, D222): one tool with the triad's arrows or its rings; each button turns
           it on in its mode, switches to it, or turns it off when it's already in it. *@
        <MudTooltip Text="@(Scene.Moving == MoveMode.Translate ? "Stop moving (W or Esc)" : "Move the selected object (W)")">
            <MudButton StartIcon="@Icons.Material.Outlined.OpenWith"
                       Color="Color.Inherit"
                       Disabled="@(!Session.IsReady)"
                       OnClick="@(() => Scene.SetMoveMode(MoveMode.Translate))"
                       Class="@ToolClass(Scene.Moving == MoveMode.Translate)"
                       aria-label="Move"
                       aria-pressed="@(Scene.Moving == MoveMode.Translate ? "true" : "false")"
                       data-testid="move-button">
                <span class="j3d-tool-label">Move</span>
            </MudButton>
        </MudTooltip>

        <MudTooltip Text="@(Scene.Moving == MoveMode.Rotate ? "Stop rotating (E or Esc)" : "Rotate the selected object (E)")">
            <MudButton StartIcon="@Icons.Material.Outlined._3dRotation"
                       Color="Color.Inherit"
                       Disabled="@(!Session.IsReady)"
                       OnClick="@(() => Scene.SetMoveMode(MoveMode.Rotate))"
                       Class="@ToolClass(Scene.Moving == MoveMode.Rotate)"
                       aria-label="Rotate"
                       aria-pressed="@(Scene.Moving == MoveMode.Rotate ? "true" : "false")"
                       data-testid="rotate-button">
                <span class="j3d-tool-label">Rotate</span>
            </MudButton>
        </MudTooltip>

        <MudTooltip Text="@(Scene.OriginFrames ? "Hide origin frames (O)" : "Show the selected objects' origin frames (O)")">
            <MudButton StartIcon="@OriginFramesIcon"
                       Color="Color.Inherit"
                       Disabled="@(!Session.IsReady)"
                       OnClick="Scene.ToggleOriginFrames"
                       Class="@ToolClass(Scene.OriginFrames)"
                       aria-label="Origin frames"
                       aria-pressed="@(Scene.OriginFrames ? "true" : "false")"
                       data-testid="origin-frames-button">
                <span class="j3d-tool-label">Origin frames</span>
            </MudButton>
        </MudTooltip>
    </div>

    @* Visibility of the selection (D97). *@
    <div class="j3d-toolbar-group j3d-fold-visibility" role="group" aria-label="Visibility" data-testid="visibility-tools">
        <MudTooltip Text="Hide the selection (H)">
            <MudIconButton Icon="@Icons.Material.Outlined.VisibilityOff"
                           Color="Color.Inherit"
                           Disabled="@(!Session.IsReady || !Scene.HasSelection)"
                           OnClick="Scene.HideSelection"
                           Class="j3d-icon-tool"
                           aria-label="Hide selection"
                           data-testid="hide-button" />
        </MudTooltip>
        <MudTooltip Text="Show only the selection (I)">
            <MudIconButton Icon="@Icons.Material.Outlined.FilterCenterFocus"
                           Color="Color.Inherit"
                           Disabled="@(!Session.IsReady || !Scene.CanIsolate)"
                           OnClick="Scene.IsolateSelection"
                           Class="j3d-icon-tool"
                           aria-label="Isolate selection"
                           data-testid="isolate-button" />
        </MudTooltip>
        <MudTooltip Text="Show everything hidden (Shift+H)">
            <MudIconButton Icon="@Icons.Material.Outlined.Visibility"
                           Color="Color.Inherit"
                           Disabled="@(!Session.IsReady || !Scene.HasHidden)"
                           OnClick="Scene.ShowAll"
                           Class="j3d-icon-tool"
                           aria-label="Show all"
                           data-testid="show-all-button" />
        </MudTooltip>
    </div>

    @* The undo history (D84), its tooltips naming the step (M17, D224). *@
    <div class="j3d-toolbar-group" role="group" aria-label="History">
        <MudTooltip Text="@(Scene.UndoLabel is { } undo ? $"Undo {undo} (Ctrl+Z)" : "Undo (Ctrl+Z)")">
            <MudIconButton Icon="@Icons.Material.Outlined.Undo"
                           Color="Color.Inherit"
                           Disabled="@(!Session.IsReady || !Scene.CanUndo)"
                           OnClick="Scene.Undo"
                           Class="j3d-icon-tool"
                           aria-label="Undo"
                           data-testid="undo-button" />
        </MudTooltip>
        <MudTooltip Text="@(Scene.RedoLabel is { } redo ? $"Redo {redo} (Ctrl+Y)" : "Redo (Ctrl+Y)")">
            <MudIconButton Icon="@Icons.Material.Outlined.Redo"
                           Color="Color.Inherit"
                           Disabled="@(!Session.IsReady || !Scene.CanRedo)"
                           OnClick="Scene.Redo"
                           Class="j3d-icon-tool"
                           aria-label="Redo"
                           data-testid="redo-button" />
        </MudTooltip>
    </div>

    @* ⋮ (M19, D235): what the bar has no room for, group by group, by the same widths in app.css that fold the
       groups (each section shows only while its group is folded); the projection in the compact layout (D240),
       and About on a phone. *@
    <div class="j3d-toolbar-group j3d-more" role="group" aria-label="More">
        <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                 Color="Color.Inherit"
                 AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight"
                 Dense="true"
                 AriaLabel="More"
                 Class="j3d-more-menu"
                 PopoverClass="j3d-more-list"
                 data-testid="more-menu">
            <div class="j3d-more-section j3d-more-add">
                <MudMenuItem Icon="@Icons.Material.Outlined.LibraryAdd" Disabled="@(!Session.IsReady)" OnClick="Scene.ToggleAddMode" role="menuitemcheckbox" aria-checked="@Checked(Scene.AddMode)" data-testid="more-add">
                    <span class="j3d-menu-command"><span>Add to the selection</span>@Tick(Scene.AddMode)</span>
                </MudMenuItem>
            </div>
            <div class="j3d-more-section j3d-more-select">
                @foreach (var mode in SelectModes)
                {
                    <MudMenuItem Icon="@ModeIcon(mode)" Disabled="@(!Session.IsReady)" OnClick="@(() => Scene.SetSelectionMode(mode))" role="menuitemradio" aria-checked="@Checked(Scene.Mode == mode)" data-testid="@($"more-mode-{ModeKey(mode)}")">
                        <span class="j3d-menu-command"><span>@ModeName(mode)</span>@Tick(Scene.Mode == mode)</span>
                    </MudMenuItem>
                }
            </div>
            <div class="j3d-more-section j3d-more-files">
                <MudMenuItem Icon="@Icons.Material.Outlined.FileOpen" Disabled="@(!Session.IsReady)" Class="j3d-menu-item-label" data-testid="more-import">
                    <label for="@InputId" class="j3d-menu-label">Import</label>
                </MudMenuItem>
                <MudMenu Label="@ExportLabel" StartIcon="@Icons.Material.Outlined.FileDownload" Dense="true" Disabled="@(!Session.IsReady || !Scene.CanExport || _exporting)" data-testid="more-export">
                    @foreach (var format in MeshFormats)
                    {
                        <MudMenuItem Label="@format.DisplayName" OnClick="@(() => StartExport(format, Scene.HasSelection))" data-testid="@($"more-export-{FormatKey(format)}")" />
                    }
                    @if (Scene.SelectionBrepModel is not null)
                    {
                        <MudDivider Class="my-1" />
                        @foreach (var format in BrepFormats)
                        {
                            <MudMenuItem Label="@format.DisplayName" OnClick="@(() => Scene.RequestModelExport(format))" data-testid="@($"more-export-{format.ToString().ToLowerInvariant()}")" />
                        }
                    }
                </MudMenu>
                <MudMenuItem Icon="@Icons.Material.Outlined.FitScreen" Disabled="@(!Session.IsReady)" OnClick="FitAllAsync" data-testid="more-fit-all">Fit all</MudMenuItem>
            </div>
            <div class="j3d-more-section j3d-more-tools">
                <MudMenuItem Icon="@Icons.Material.Outlined.Straighten" Disabled="@(!Session.IsReady)" OnClick="Scene.ToggleMeasureMode" role="menuitemcheckbox" aria-checked="@Checked(Scene.MeasureMode)" data-testid="more-measure">
                    <span class="j3d-menu-command"><span>Measure</span>@Tick(Scene.MeasureMode)</span>
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.OpenWith" Disabled="@(!Session.IsReady)" OnClick="@(() => Scene.SetMoveMode(MoveMode.Translate))" role="menuitemcheckbox" aria-checked="@Checked(Scene.Moving == MoveMode.Translate)" data-testid="more-move">
                    <span class="j3d-menu-command"><span>Move</span>@Tick(Scene.Moving == MoveMode.Translate)</span>
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined._3dRotation" Disabled="@(!Session.IsReady)" OnClick="@(() => Scene.SetMoveMode(MoveMode.Rotate))" role="menuitemcheckbox" aria-checked="@Checked(Scene.Moving == MoveMode.Rotate)" data-testid="more-rotate">
                    <span class="j3d-menu-command"><span>Rotate</span>@Tick(Scene.Moving == MoveMode.Rotate)</span>
                </MudMenuItem>
                <MudMenuItem Icon="@OriginFramesIcon" Disabled="@(!Session.IsReady)" OnClick="Scene.ToggleOriginFrames" role="menuitemcheckbox" aria-checked="@Checked(Scene.OriginFrames)" data-testid="more-origin-frames">
                    <span class="j3d-menu-command"><span>Origin frames</span>@Tick(Scene.OriginFrames)</span>
                </MudMenuItem>
            </div>
            <div class="j3d-more-section j3d-more-visibility">
                <MudMenuItem Icon="@Icons.Material.Outlined.VisibilityOff" Disabled="@(!Session.IsReady || !Scene.HasSelection)" OnClick="Scene.HideSelection" data-testid="more-hide">Hide</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.FilterCenterFocus" Disabled="@(!Session.IsReady || !Scene.CanIsolate)" OnClick="Scene.IsolateSelection" data-testid="more-isolate">Isolate</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Visibility" Disabled="@(!Session.IsReady || !Scene.HasHidden)" OnClick="Scene.ShowAll" data-testid="more-show-all">Show all</MudMenuItem>
            </div>
            <div class="j3d-more-section j3d-more-projection">
                <MudMenuItem Icon="@Icons.Material.Outlined.CropFree" Disabled="@(!Session.IsReady)" OnClick="@(() => SetProjectionAsync(Projection.Orthographic))" role="menuitemradio" aria-checked="@Checked(Session.Projection == Projection.Orthographic)" data-testid="more-orthographic">
                    <span class="j3d-menu-command"><span>Orthographic</span>@Tick(Session.Projection == Projection.Orthographic)</span>
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Landscape" Disabled="@(!Session.IsReady)" OnClick="@(() => SetProjectionAsync(Projection.Perspective))" role="menuitemradio" aria-checked="@Checked(Session.Projection == Projection.Perspective)" data-testid="more-perspective">
                    <span class="j3d-menu-command"><span>Perspective</span>@Tick(Session.Projection == Projection.Perspective)</span>
                </MudMenuItem>
            </div>
            <div class="j3d-more-section j3d-more-about">
                <MudMenuItem Icon="@Icons.Material.Outlined.Info" OnClick="OnAbout" data-testid="more-about">About J3D</MudMenuItem>
            </div>
        </MudMenu>
    </div>
</div>
