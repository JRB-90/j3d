<div class="j3d-toolbar" data-testid="toolbar">
    @* A native label opens the file picker, so no JS user-activation trickery is needed (docs/plan.md §6.4).
       The viewer sets the input's accept list and imports what is picked. *@
    <input @ref="_input"
           id="@InputId"
           type="file"
           multiple
           class="j3d-visually-hidden"
           disabled="@(!Session.IsReady)"
           data-testid="import-input" />
    <MudButton HtmlTag="label"
               for="@InputId"
               StartIcon="@Icons.Material.Filled.FileOpen"
               Color="Color.Inherit"
               Disabled="@(!Session.IsReady)"
               Class="j3d-collapsible"
               title="Import"
               data-testid="import-button">
        Import
    </MudButton>

    @* Export (M9, D119): the selection when there is one, else every visible part. Busy while it's written (D125). *@
    <MudMenu Label="@(_exporting ? "Exporting…" : "Export")"
             StartIcon="@(_exporting ? Icons.Material.Filled.HourglassTop : Icons.Material.Filled.FileDownload)"
             Color="Color.Inherit"
             Disabled="@(!Session.IsReady || !Scene.CanExport || _exporting)"
             AnchorOrigin="Origin.BottomLeft"
             TransformOrigin="Origin.TopLeft"
             Dense="true"
             AriaLabel="@ExportLabel"
             Class="j3d-collapsible"
             title="Export"
             aria-busy="@(_exporting ? "true" : "false")"
             data-testid="export-menu">
        <div class="j3d-menu-header" data-testid="export-scope">@ExportLabel</div>
        @foreach (var format in MeshFormats)
        {
            <MudMenuItem Label="@format.DisplayName" OnClick="@(() => StartExport(format, Scene.HasSelection))" data-testid="@($"export-{FormatKey(format)}")" />
        }
    </MudMenu>

    <MudTooltip Text="Fit all (F)">
        <MudButton StartIcon="@Icons.Material.Filled.FitScreen"
                   Color="Color.Inherit"
                   Disabled="@(!Session.IsReady)"
                   OnClick="FitAllAsync"
                   Class="j3d-collapsible"
                   data-testid="fit-all-button">
            Fit all
        </MudButton>
    </MudTooltip>

    <MudToggleGroup T="Projection"
                    Value="Session.Projection"
                    ValueChanged="SetProjectionAsync"
                    Size="Size.Small"
                    Color="Color.Primary"
                    Disabled="@(!Session.IsReady)"
                    Class="j3d-projection"
                    data-testid="projection">
        <MudToggleItem Value="Projection.Orthographic" Text="Orthographic" />
        <MudToggleItem Value="Projection.Perspective" Text="Perspective" />
    </MudToggleGroup>

    @* What a click selects (M12, D146): models, objects or features, with the keys 1, 2 and 3 (D162). *@
    <MudToggleGroup T="SelectMode"
                    Value="Scene.Mode"
                    ValueChanged="Scene.SetSelectionMode"
                    Size="Size.Small"
                    Color="Color.Primary"
                    Disabled="@(!Session.IsReady)"
                    Class="j3d-selection-mode"
                    aria-label="Selection mode"
                    data-testid="selection-mode">
        @foreach (var mode in SelectModes)
        {
            <MudToggleItem Value="mode" aria-pressed="@(Scene.Mode == mode ? "true" : "false")" data-testid="@($"mode-{ModeKey(mode)}")">
                <MudTooltip Text="@ModeTooltip(mode)">
                    <MudIcon Icon="@ModeIcon(mode)" Size="Size.Small" aria-label="@ModeTooltip(mode)" />
                </MudTooltip>
            </MudToggleItem>
        }
    </MudToggleGroup>

    @* The Measure tool (M7, D79): a toggle, highlighted while it's on. *@
    <MudTooltip Text="@(Scene.MeasureMode ? "Stop measuring (M)" : "Measure (M)")">
        <MudIconButton Icon="@Icons.Material.Filled.Straighten"
                       Color="@(Scene.MeasureMode ? Color.Primary : Color.Inherit)"
                       Variant="@(Scene.MeasureMode ? Variant.Outlined : Variant.Text)"
                       Disabled="@(!Session.IsReady)"
                       OnClick="Scene.ToggleMeasureMode"
                       aria-label="Measure"
                       aria-pressed="@(Scene.MeasureMode ? "true" : "false")"
                       Class="j3d-measure-button"
                       data-testid="measure-button" />
    </MudTooltip>

    @* Visibility of the selection, then the undo history (decision D97). *@
    <div class="j3d-toolbar-group" role="group" aria-label="Visibility and history" data-testid="visibility-tools">
        <MudTooltip Text="Hide selection (H)">
            <MudIconButton Icon="@Icons.Material.Filled.VisibilityOff"
                           Color="Color.Inherit"
                           Disabled="@(!Session.IsReady || !Scene.HasSelection)"
                           OnClick="Scene.HideSelection"
                           aria-label="Hide selection"
                           data-testid="hide-button" />
        </MudTooltip>
        <MudTooltip Text="Isolate selection (I)">
            <MudIconButton Icon="@Icons.Material.Filled.FilterCenterFocus"
                           Color="Color.Inherit"
                           Disabled="@(!Session.IsReady || !Scene.CanIsolate)"
                           OnClick="Scene.IsolateSelection"
                           aria-label="Isolate selection"
                           data-testid="isolate-button" />
        </MudTooltip>
        <MudTooltip Text="Show all (Shift+H)">
            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                           Color="Color.Inherit"
                           Disabled="@(!Session.IsReady || !Scene.HasHidden)"
                           OnClick="Scene.ShowAll"
                           aria-label="Show all"
                           data-testid="show-all-button" />
        </MudTooltip>
        <MudTooltip Text="Undo (Ctrl+Z)">
            <MudIconButton Icon="@Icons.Material.Filled.Undo"
                           Color="Color.Inherit"
                           Disabled="@(!Session.IsReady || !Scene.CanUndo)"
                           OnClick="Scene.Undo"
                           aria-label="Undo"
                           data-testid="undo-button" />
        </MudTooltip>
        <MudTooltip Text="Redo (Ctrl+Y)">
            <MudIconButton Icon="@Icons.Material.Filled.Redo"
                           Color="Color.Inherit"
                           Disabled="@(!Session.IsReady || !Scene.CanRedo)"
                           OnClick="Scene.Redo"
                           aria-label="Redo"
                           data-testid="redo-button" />
        </MudTooltip>
    </div>
</div>
