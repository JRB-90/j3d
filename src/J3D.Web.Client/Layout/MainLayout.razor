@inherits LayoutComponentBase

<MudThemeProvider Theme="J3DTheme.Instance" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="j3d-layout">
    <MudAppBar Elevation="0" Class="j3d-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       aria-label="Toggle model list"
                       OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-2">J3D</MudText>
        <MudSpacer />
        @* Iteration 1 toolbar (Import, Fit all, Projection) is added in milestone M4 — see docs/plan.md. *@
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Always"
               Variant="DrawerVariant.Persistent"
               Elevation="0"
               Class="j3d-drawer">
        <MudText Typo="Typo.subtitle2" Class="px-4 pt-4 pb-2 mud-text-secondary">Models</MudText>
        <MudText Typo="Typo.body2" Class="px-4 mud-text-disabled">No models imported.</MudText>
    </MudDrawer>

    <MudMainContent Class="j3d-main">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
