<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Publishing trims (TrimMode partial); the analyzer turns anything trim-unsafe in this code into a build error (D65). -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- The app's browser code is its own npm workspace, built below; none of it is .NET content. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);scripts\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="MudBlazor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\J3D.Blazor\J3D.Blazor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="J3D.Web.Client.Tests" />
  </ItemGroup>

  <!--
    The app's own browser code (TypeScript + Vite): the build in scripts/ writes it into wwwroot/app, which
    is git-ignored. Set -p:SkipViewerBuild=true to build the .NET side only.
  -->
  <PropertyGroup>
    <ScriptsProjectDir>$(MSBuildThisFileDirectory)scripts\</ScriptsProjectDir>
    <AppScriptsOutputDir>$(MSBuildThisFileDirectory)wwwroot\app\</AppScriptsOutputDir>
    <AppScriptsEntryFile>$(AppScriptsOutputDir)j3d-app.js</AppScriptsEntryFile>
  </PropertyGroup>

  <ItemGroup>
    <AppScriptSource Include="$(ScriptsProjectDir)src\**\*.ts" Exclude="$(ScriptsProjectDir)src\**\*.test.ts" />
    <AppScriptSource Include="$(ScriptsProjectDir)package.json;$(ScriptsProjectDir)tsconfig.json;$(ScriptsProjectDir)vite.config.ts" />
    <AppScriptSource Include="$(RepoRoot)package-lock.json" />
    <Content Remove="wwwroot\app\**" />
  </ItemGroup>

  <Target Name="J3DBuildAppScripts"
          BeforeTargets="AssignTargetPaths;ResolveStaticWebAssetsInputs"
          Condition="'$(SkipViewerBuild)' != 'true'"
          Inputs="@(AppScriptSource)"
          Outputs="$(AppScriptsEntryFile)">
    <Exec Command="npm run build --workspace @j3d/client-scripts" WorkingDirectory="$(RepoRoot)" />
  </Target>

  <!-- Files produced during the build are not in the evaluation-time Content glob, so add them explicitly. -->
  <Target Name="J3DIncludeAppScripts" AfterTargets="J3DBuildAppScripts" BeforeTargets="AssignTargetPaths;ResolveStaticWebAssetsInputs">
    <ItemGroup>
      <Content Include="wwwroot\app\**" />
    </ItemGroup>
  </Target>

</Project>
