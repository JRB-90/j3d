{
  "name": "@j3d/occt",
  "version": "0.0.0",
  "private": true,
  "description": "Custom OCCT 8 WebAssembly build for J3D (libcascade toolchain) and its TypeScript facade.",
  "type": "module",
  "exports": {
    "./facade": "./src/facade.ts",
    "./single": {
      "types": "./dist/variant.d.ts",
      "default": "./dist/j3d_occt_single.js"
    },
    "./single/wasm": "./dist/j3d_occt_single.wasm"
  },
  "scripts": {
    "build:wasm": "libcascade build && libcascade assemble",
    "render:wasm": "libcascade build --render-only",
    "check:dist": "node scripts/check-dist.mjs",
    "benchmark:threads": "node scripts/benchmark-threads.mjs",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@libcascade/toolchain": "^3.1.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
