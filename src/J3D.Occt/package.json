{
  "name": "@j3d/occt",
  "version": "0.0.0",
  "private": true,
  "description": "Custom OCCT 8 WebAssembly build for J3D (libcascade toolchain) and its TypeScript facade.",
  "license": "LGPL-2.1-only WITH OCCT-exception-1.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "j3d-source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./core": {
      "j3d-source": "./src/core.ts",
      "types": "./lib/core.d.ts",
      "default": "./lib/core.js"
    },
    "./facade": {
      "j3d-source": "./src/facade.ts",
      "types": "./lib/facade.d.ts",
      "default": "./lib/facade.js"
    },
    "./single": {
      "types": "./dist/variant.d.ts",
      "default": "./dist/j3d_occt_single.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:wasm": "libcascade build && libcascade assemble",
    "render:wasm": "libcascade build --render-only",
    "check:dist": "node scripts/check-dist.mjs",
    "benchmark:threads": "node scripts/benchmark-threads.mjs",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@libcascade/toolchain": "^3.1.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
