# Normalise line endings; let Git decide per platform.
* text=auto

# Windows-only scripts keep CRLF, shell scripts keep LF.
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh  text eol=lf

# The OCCT build hashes its C++ sources into dist/*.provenance.json; keep them byte-identical on
# every platform so CI's staleness check matches locally built binaries.
src/J3D.Occt/** text=auto eol=lf

# Built OCCT WebAssembly binaries (src/J3D.Occt/dist) are stored in Git LFS.
*.wasm filter=lfs diff=lfs merge=lfs -text

# CAD/mesh files keep their exact bytes (no line-ending conversion).
*.step -text
*.stp  -text
*.iges -text
*.igs  -text
*.brep -text
*.obj  -text
*.mtl  -text
*.gltf -text
*.glb  binary
*.stl  binary
*.bin  binary
*.png  binary
*.ktx2 binary
