@page "/"
@rendermode InteractiveWebAssembly
@implements IDisposable
@inject SceneState Scene
@inject ViewerSession Session

<PageTitle>J3D sample</PageTitle>

<div class="sample">
    <header>
        <h1>J3D sample</h1>
        <input @ref="_files" id="files" type="file" multiple />
        <span id="status">@Status</span>
    </header>

    <J3DViewer class="viewer" OnReady="AttachFilesAsync" OnNotice="Show" />
</div>

@code {
    private ElementReference _files;
    private string? _notice;

    // The scene keeps the selection, undo and the tree, and the viewer draws them.
    private string Status => Scene.Selection switch
    {
        [var (model, node), ..] => model.Tree?.NameOf(node) ?? model.Summary.FileName,
        _ when Scene.Models.Any(model => model.IsPending) => "Opening…",
        _ when _notice is not null => _notice,
        _ when Scene.Models.IsEmpty => "Choose a file, or drop one on the view.",
        _ => "Click a part to select it.",
    };

    protected override void OnInitialized() => Scene.Changed += Refresh;

    public void Dispose() => Scene.Changed -= Refresh;

    private void Refresh()
    {
        if (Scene.Models.Any(model => model.IsPending))
        {
            _notice = null;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private Task AttachFilesAsync(ViewerCapabilities capabilities) => Session.AttachFileInputAsync(_files);

    private void Show(ViewerNotice notice) => _notice = notice.Message;
}
