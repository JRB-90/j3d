<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- The folder holding the .nupkg from the release: NuGet can't install from a URL. -->
    <add key="j3d" value="packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- J3D.Blazor isn't on nuget.org, so make sure that's never where it comes from. -->
  <packageSourceMapping>
    <packageSource key="j3d">
      <package pattern="J3D.Blazor" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
